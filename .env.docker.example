# -------------------------------------------------------------
# Certified - Docker Environment Configuration Template
# Experiment 10: Docker and DevOps Deployment
# 
# Usage:
# 1. Copy this file to .env.docker:
#    cp .env.docker.example .env.docker
# 2. Fill in your MongoDB Atlas URI and JWT Secret.
# 3. Start the Docker setup:
#    docker compose -f docker-compose.docker.yml --env-file .env.docker up --build
# -------------------------------------------------------------

# Backend Port exposed on the host machine
BACKEND_PORT=5000

# Frontend Port exposed on the host machine (mapped to port 80 inside container)
FRONTEND_PORT=3000

# MongoDB Atlas Database Connection URI
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/certified?retryWrites=true&w=majority

# JWT Secret Key (Must be at least 32 characters for production security)
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters_123456

# Cloudinary Storage Credentials (Optional - if blank or DEMO_MODE=true, data URLs are used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed Frontend Origins for CORS (comma-separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5173,https://hoppscotch.io

# Demo Mode (true enables fallbacks for college practical demonstration)
DEMO_MODE=true

# Frontend API Base URL for Docker build
# Use '/api' for reverse proxy through Nginx
VITE_API_BASE_URL=/api
